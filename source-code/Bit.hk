[package]
-> name        => isolator
-> version     => 0.7.0
-> description => Podman-based package manager for HackerOS
-> authors     => ["HackerOS-Linux-System"]
-> license     => Apache-2.0
-> lang        => h#

[edition]
-> edition   => 2026
-> toolchain => 0.9

[layout]
-> src   => src
-> entry => src/main.h#

[build]
-> link => static

[default-build]
-> profile => release
