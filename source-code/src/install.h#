fn find_package(repo_packages: [PackageInfo], name: string) -> (bool, PackageInfo) is
    let n: int = array_len(repo_packages)
    let mut i: int = 0
    while i < n is
        if repo_packages[i].name == name is return (true, repo_packages[i]) end
        i += 1
    end
    return (false, PackageInfo { name: "", distro: "", kind: "", libs: [] })
end
