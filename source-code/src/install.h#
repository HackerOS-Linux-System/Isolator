fn catalog_libs_to_names(libs: [PackageInfo]) -> [string] is
    let mut names: [string] = []
    let n: int = array_len(libs)
    let mut i: int = 0
    while i < n is
        names = array_push(names, libs[i].name)
        i += 1
    end
    return names
end

fn bool_label_str(b: bool, if_true: string, if_false: string) -> string is
