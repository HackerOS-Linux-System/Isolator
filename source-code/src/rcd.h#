mod exec
mod helpers

fn rcd_script(pkg: string) -> string is
    return "#!/bin/sh\n" +
        "# /etc/rc.d/rc." + pkg + " — start/stop/restart the " + pkg + " service.\n" +
        "# Generated by Isolator (this distro's image has no systemd — see\n" +
        "# Distro.init_system in distros.h# — so \"system\"-type packages get a\n" +
        "# classic BSD-style rc.d script here instead of a unit file).\n\n" +
        "case \"$1\" in\n" +
        "  start)\n" +
        "    echo \"Starting " + pkg + "...\"\n" +
        "    " + pkg + " >/var/log/" + pkg + ".log 2>&1 &\n" +
        "    echo $! > /var/run/" + pkg + ".pid\n" +
        "    ;;\n" +
        "  stop)\n" +
        "    echo \"Stopping " + pkg + "...\"\n" +
        "    if [ -f /var/run/" + pkg + ".pid ]; then\n" +
        "      kill \"$(cat /var/run/" + pkg + ".pid)\" 2>/dev/null\n" +
        "      rm -f /var/run/" + pkg + ".pid\n" +
        "    else\n" +
        "      pkill -f \"" + pkg + "\" 2>/dev/null\n" +
        "    fi\n" +
        "    ;;\n" +
        "  restart)\n" +
        "    \"$0\" stop\n" +
        "    sleep 1\n" +
        "    \"$0\" start\n" +
        "    ;;\n" +
        "  status)\n" +
        "    if [ -f /var/run/" + pkg + ".pid ] && kill -0 \"$(cat /var/run/" + pkg + ".pid)\" 2>/dev/null; then\n" +
        "      echo \"" + pkg + " is running (pid $(cat /var/run/" + pkg + ".pid))\"\n" +
        "    else\n" +
        "      echo \"" + pkg + " is not running\"\n" +
        "    fi\n" +
        "    ;;\n" +
        "  *)\n" +
        "    echo \"usage: $0 {{start|stop|restart|status}}\"\n" +
        "    exit 1\n" +
        "    ;;\n" +
        "esac\n"
end

;; generate_rcd_script returns "" on success, or an error message.
pub fn generate_rcd_script(cont: string, pkg: string) -> string is
    let dest: string = "/etc/rc.d/rc." + pkg
    let script: string = rcd_script(pkg)

    ;; Write via a heredoc through sh -c so we don't need a separate
    ;; podman-cp round trip for a few hundred bytes of shell script.
    let write_cmd: string = "cat > " + dest + " << 'ISOLATOR_RCD_EOF'\n" + script + "\nISOLATOR_RCD_EOF\nchmod 755 " + dest
    if !exec::exec_in_container(cont, write_cmd, false, true) is
        return "failed to write " + dest + " inside container '" + cont + "'"
    end

    ;; Wire it into rc.local so it actually starts on boot, the standard
    ;; Slackware way of adding a "local" service — idempotent (won't add
    ;; the line twice on reinstall).
    let hook_line: string = "[ -x " + dest + " ] && " + dest + " start"
    let ensure_cmd: string = "touch /etc/rc.d/rc.local && grep -qxF '" + hook_line + "' /etc/rc.d/rc.local || echo '" + hook_line + "' >> /etc/rc.d/rc.local"
    if !exec::exec_in_container(cont, ensure_cmd, false, true) is
        helpers::print_warn("Wrote rc.d script but failed to hook it into rc.local — start it manually")
    end

    return ""
end

;; remove_rcd_script deletes the generated script and its rc.local hook
;; line (best-effort — used by handle_remove when removing a "system"
;; package from a non-systemd distro).
pub fn remove_rcd_script(cont: string, pkg: string) is
    let dest: string = "/etc/rc.d/rc." + pkg
    exec::exec_in_container(cont, dest + " stop 2>/dev/null; rm -f " + dest, false, true)
    let hook_line: string = "[ -x " + dest + " ] && " + dest + " start"
    let cleanup_cmd: string = "sed -i '\\#" + hook_line + "#d' /etc/rc.d/rc.local 2>/dev/null"
    exec::exec_in_container(cont, cleanup_cmd, false, true)
end
