;; snapshot_one does the actual commit + bookkeeping for a single
;; container, shared by handle_snapshot and handle_snapshot_all. Returns
;; (tag, "") on success, or ("", error).
fn snapshot_one(cont: string) -> (string, string) is
    let now: int = time_ms() / 1000
    let tag: string = "isolator-snapshot/" + cont + ":" + to_string(now)
    helpers::print_step("Committing snapshot of " + cont + "...")
    if !exec::exec_command(constants::PODMAN_BIN, ["commit", cont, tag]) is
        return ("", "snapshot of '" + cont + "' failed")
    end
    let mut recs: [SnapshotRecord] = load_snapshots()
    recs = array_push(recs, SnapshotRecord { container: cont, image: tag, created_at: now })
    if !save_snapshots(recs) is
        return ("", "snapshot of '" + cont + "' created but failed to record metadata")
    end
    helpers::print_success("Snapshot saved: " + tag)
    return (tag, "")
end

