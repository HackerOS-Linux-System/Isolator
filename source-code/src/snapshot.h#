    if array_len(plans) == 0 is
        helpers::print_warn("No managed container has a snapshot to roll back to — run 'isolator snapshot-all' first, next time")
        return
    end

    if dry_run is
        helpers::print_info("[dry-run] Would roll back " + to_string(array_len(plans)) + "/" + to_string(array_len(conts)) + " managed container(s):")
        let np: int = array_len(plans)
