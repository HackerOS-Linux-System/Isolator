;; latest_snapshot_for returns (found, SnapshotRecord) — the most recent
;; snapshot recorded for `cont`.
fn latest_snapshot_for(cont: string, recs: [SnapshotRecord]) -> (bool, SnapshotRecord) is
    let mut found: bool = false
    let mut latest: SnapshotRecord = SnapshotRecord { container: "", image: "", created_at: 0 }
    let n: int = array_len(recs)
    let mut i: int = 0
    while i < n is
        let r: SnapshotRecord = recs[i]
        if r.container == cont is
            if !found || r.created_at > latest.created_at is
                latest = r
                found = true
            end
        end
        i += 1
    end
    return (found, latest)
end

