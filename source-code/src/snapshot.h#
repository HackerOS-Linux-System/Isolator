;; handle_snapshot_list shows saved snapshots, most recent first.
pub fn handle_snapshot_list() is
    let recs: [SnapshotRecord] = load_snapshots()
    if array_len(recs) == 0 is
        helpers::print_info("No snapshots saved yet")
        return
    end
    let sorted: [SnapshotRecord] = sort_by_created_desc(recs)
    let n: int = array_len(sorted)
    let mut i: int = 0
    while i < n is
        let r: SnapshotRecord = sorted[i]
        write("  " + cyan(r.container) + "  " + r.image + "  " + dim(util::format_rfc3339(r.created_at)))
        i += 1
    end
end

fn sort_by_created_desc(recs: [SnapshotRecord]) -> [SnapshotRecord] is
    let mut arr: [SnapshotRecord] = recs
    let n: int = array_len(arr)
    let mut i: int = 0
    while i < n is
        let mut max_idx: int = i
        let mut j: int = i + 1
        while j < n is
            if arr[j].created_at > arr[max_idx].created_at is max_idx = j end
            j += 1
        end
        if max_idx != i is
            let tmp: SnapshotRecord = arr[i]
            arr[i] = arr[max_idx]
            arr[max_idx] = tmp
        end
        i += 1
    end
    return arr
end
