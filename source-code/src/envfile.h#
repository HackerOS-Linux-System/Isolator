pub struct EnvVarPair is
    pub key: string
    pub val: string
end

pub struct EnvSpec is
    pub name:        string
    pub distro:      string
    pub shell:       string
    pub packages:    [string]
    pub env_vars:    [EnvVarPair]
    pub file_path:   string
    pub project_dir: string
end

fn env_container_name(name: string) -> string is
    return "isolator-env-" + name
end

;; parse_env_file loads and validates a project environment definition.
;; Returns ("", spec) on success, or (error, empty_spec).
pub fn parse_env_file(path: string) -> (string, EnvSpec) is
