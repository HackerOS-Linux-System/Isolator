    let _ok: bool = __dstr104.0
    let d: Distro = __dstr104.1
    let cont_name: string = env_container_name(spec.name)

    helpers::print_info("Environment " + bold(spec.name) + "  [distro: " + cyan(spec.distro) + " | project: " + dim(spec.project_dir) + "]")

    let first_build: bool = !container::container_exists(cont_name)
    if first_build is
        helpers::print_step("Creating environment container (bind-mounted to your project dir)...")
        if !container::create_container(cont_name, d.image, spec.project_dir, "cli", d.init_system) is
            helpers::print_error("Failed to create environment container '" + cont_name + "'")
            return
        end
        if !container::init_container(cont_name, d) is
            helpers::print_warn("Package manager init returned non-zero (may be OK for some distros)")
        end
    else if !container::ensure_container_running(cont_name) is
        helpers::print_error("Failed to start environment container '" + cont_name + "'")
        return
    end

    if array_len(spec.packages) > 0 is
        let installed: [string] = installed_in_env(cont_name)
        let mut missing: [string] = []
        let np: int = array_len(spec.packages)
        let mut i: int = 0
        while i < np is
            let p: string = spec.packages[i]
            if !util::array_contains_string(installed, p) is missing = array_push(missing, p) end
            i += 1
        end
        if array_len(missing) > 0 is
            helpers::print_info("Installing: " + util::string_join(missing, ", "))
            let cmd: string = distros::adapter_install(spec.distro) + " " + util::string_join(missing, " ")
            if !exec::exec_in_container(cont_name, cmd, false, true) is
                helpers::print_error("Failed to install one or more packages into the environment")
                return
            end
            mark_installed_in_env(cont_name, spec.packages)
