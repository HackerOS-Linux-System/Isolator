    let interp_err: string = __dstr101.0
    let doc: HkDocument = __dstr101.1
    if interp_err != "" is return (interp_err, empty_env_spec()) end

    let env: HkMap = hkfmt::hkdoc_section(doc, "environment")
    let mut name: string = hkfmt::hk_get_string(env, "name", "")
    if name == "" is
        ;; Fall back to the file's base name, e.g. "dev.hk" -> "dev".
        name = base_name_no_ext(abs)
    end
    let name_err: string = security::validate_package_name(name)
    if name_err != "" is return ("[environment] -> name: " + name_err, empty_env_spec()) end

    let distro: string = hkfmt::hk_get_string(env, "distro", "debian")
    let __dstr102: (bool, Distro) = distros::lookup_distro(distro)
    let distro_ok: bool = __dstr102.0
    let _d: Distro = __dstr102.1
    if !distro_ok is return ("[environment] -> distro: unknown distro \"" + distro + "\"", empty_env_spec()) end

    let shell: string = hkfmt::hk_get_string(env, "shell", "bash")

    let mut packages: [string] = []
    let pkg_sec: HkMap = hkfmt::hkdoc_section(doc, "packages")
    let pkg_keys: [string] = hkfmt::hkmap_keys(pkg_sec)
    let np: int = array_len(pkg_keys)
    let mut i: int = 0
    while i < np is
        let k: string = pkg_keys[i]
        let kerr: string = security::validate_package_name(k)
        if kerr != "" is return ("[packages]: " + kerr, empty_env_spec()) end
        packages = array_push(packages, k)
        i += 1
    end

    let mut env_vars: [EnvVarPair] = []
    let env_sec: HkMap = hkfmt::hkdoc_section(doc, "env")
    let env_keys: [string] = hkfmt::hkmap_keys(env_sec)
    let ne: int = array_len(env_keys)
    let mut j: int = 0
    while j < ne is
        let k: string = env_keys[j]
        let v: HkValue = hkfmt::hkmap_get(env_sec, k)
        if v.kind == "array" || v.kind == "map" is
            return ("[env] -> " + k + ": value must be string-like", empty_env_spec())
        end
        env_vars = array_push(env_vars, EnvVarPair { key: k, val: hkfmt::hk_as_string(v) })
        j += 1
    end

    return ("", EnvSpec {
        name: name, distro: distro, shell: shell,
        packages: packages, env_vars: env_vars,
        file_path: abs, project_dir: dir_name(abs),
    })
end

fn empty_env_spec() -> EnvSpec is
    return EnvSpec { name: "", distro: "", shell: "", packages: [], env_vars: [], file_path: "", project_dir: "" }
end

fn base_name_no_ext(path: string) -> string is
    let slash: int = string_rfind(path, "/")
    let base: string = if slash >= 0 then string_slice(path, slash + 1, string_len(path)) else path 
    let dot: int = string_rfind(base, ".")
    if dot > 0 is return string_slice(base, 0, dot) end
    return base
end

fn dir_name(path: string) -> string is
    let slash: int = string_rfind(path, "/")
    if slash < 0 is return "." end
    if slash == 0 is return "/" end
    return string_slice(path, 0, slash)
end

;; handle_env_file builds (if needed) and activates the environment
;; described by an .hk file, dropping the user into an interactive shell
;; inside it.
