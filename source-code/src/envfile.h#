    let nv: int = array_len(spec.env_vars)
    let mut k: int = 0
    while k < nv is
        args = array_push(args, "--env")
        args = array_push(args, spec.env_vars[k].key + "=" + spec.env_vars[k].val)
        k += 1
    end
    args = array_push(args, cont_name)
    args = array_push(args, spec.shell)
    exec::exec_command(constants::PODMAN_BIN, args)
end

;; installed_in_env reads the small marker file the environment writes
;; inside the container after a successful install batch, to avoid
;; re-running the package manager (and re-downloading everything) on every
;; activation.
fn installed_in_env(cont: string) -> [string] is
    let __dstr105: (string, bool) = exec::exec_in_container_with_output(cont, "cat /etc/isolator-env-installed 2>/dev/null", false)
    let out: string = __dstr105.0
    let ok: bool = __dstr105.1
    let mut result: [string] = []
    if !ok || out == "" is return result end
    let lines: [string] = string_split(out, "\n")
    let n: int = array_len(lines)
    let mut i: int = 0
    while i < n is
        let l: string = string_trim(lines[i])
        if l != "" is result = array_push(result, l) end
        i += 1
    end
    return result
end

fn mark_installed_in_env(cont: string, packages: [string]) is
    let content: string = util::string_join(packages, "\\n")
    exec::exec_in_container(cont, "printf '%b' \"" + content + "\" > /etc/isolator-env-installed", false, false)
end

;; is_env_file reports whether args look like `isolator <something>.hk`
;; rather than a known subcommand — used by main.h# to route bare .hk files.
;; Returns (path, true) or ("", false).
pub fn is_env_file(args: [string]) -> (string, bool) is
    if array_len(args) != 1 is return ("", false) end
    if !string_ends_with(args[0], ".hk") is return ("", false) end
    if !file_exists(args[0]) is return ("", false) end
    return (args[0], true)
end
