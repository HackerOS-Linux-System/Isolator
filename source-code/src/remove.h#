;; find_dependents returns the names of other installed packages, sharing
;; pkg's container, whose recorded Requires (set at install time — see
;; classify_libs in deps.h#) lists pkg. This reads directly from the
;; persisted installed.hk state instead of re-deriving the same answer by
;; re-scanning the repo's Libs lists on every removal — the repo lookup
;; already happened once, at install time, and its result was saved.
;;
;; One consequence: a package installed before Requires existed (or whose
;; only dependencies were raw, non-cataloged lib strings) won't show up as
;; a recorded dependent even if it happens to still need pkg. That's a
;; known, accepted trade-off for not re-deriving state that's supposed to
;; be authoritative.
fn find_dependents(pkg: string, cont: string, installed: [InstalledPackage]) -> [string] is
    let mut dependents: [string] = []
    let n: int = array_len(installed)
    let mut i: int = 0
    while i < n is
        let ip: InstalledPackage = installed[i]
        if ip.pkg != pkg && ip.cont == cont is
            let nr: int = array_len(ip.requires)
            let mut j: int = 0
            while j < nr is
                if ip.requires[j] == pkg is
                    dependents = array_push(dependents, ip.pkg)
                    j = nr
                end
                j += 1
            end
        end
        i += 1
    end
    return dependents
end

