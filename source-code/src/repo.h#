;; backend on this compiler (undefined fn at codegen time — see
;; jsonlite.h#'s doc comment for the full story). jsonlite.h# is a real
;; JSON parser that actually works, used below instead.
mod jsonlite

;; load_repo ensures a fresh-enough, valid local repo cache exists,
;; downloading it if missing/stale/forced. Returns true on success.
pub fn load_repo(force: bool) -> bool is
    if !helpers::ensure_config_dir() is
        helpers::print_error("Failed to create config directory")
        return false
    end

    let repo_file_path: string = helpers::get_repo_file_path()
    let mut needs_download: bool = force

    if !needs_download is
        if !file_exists(repo_file_path) is
            needs_download = true
        else is
            let age_ms: int = time_ms() - util::file_mtime_ms(repo_file_path)
            if age_ms > constants::CACHE_MAX_AGE_MS is needs_download = true end
        end
    end

    if needs_download is
        if !download_repo(repo_file_path) is return false end
    end

    ;; Validate readable + validate every package name in it.
    if !file_exists(repo_file_path) is
        helpers::print_error("Failed to read repo file")
        return false
    end
    let data: string = file_read(repo_file_path)
    let pkgs: [PackageInfo] = parse_package_list(data)
    if array_len(pkgs) == 0 && string_trim(data) != "[]" is
        helpers::print_error("Repo cache is corrupted — run 'isolator refresh'")
        file_delete(repo_file_path)
        return false
    end
    let n: int = array_len(pkgs)
    let mut i: int = 0
    while i < n is
        let err: string = security::validate_package_name(pkgs[i].name)
        if err != "" is
            helpers::print_error("Repository contains an unsafe package entry: " + err)
            helpers::print_info("Refusing to trust this repo cache — run 'isolator refresh'")
            file_delete(repo_file_path)
            return false
        end
        i += 1
    end
    return true
end

fn parse_package_list(raw: string) -> [PackageInfo] is
    let items: [jsonlite::JVal] = jsonlite::jl_parse_array(raw)
    let n: int = array_len(items)
    let mut result: [PackageInfo] = []
    let mut i: int = 0
    while i < n is
        let obj: jsonlite::JVal = items[i]
        let libs_raw: [jsonlite::JVal] = jsonlite::jl_get_arr(obj, "libs")
        let nl: int = array_len(libs_raw)
        let mut libs: [string] = []
        let mut j: int = 0
        while j < nl is
            libs = array_push(libs, jsonlite::jl_str_at(libs_raw, j))
            j += 1
        end
        result = array_push(result, PackageInfo {
            name: jsonlite::jl_get_str(obj, "name"),
            distro: jsonlite::jl_get_str(obj, "distro"),
            kind: jsonlite::jl_get_str(obj, "type"),
            libs: libs,
        })
        i += 1
    end
    return result
end

;; download_repo fetches package-list.json (and, best-effort, its .sha256
;; sidecar) and atomically replaces the local cache. If a checksum file is
;; published, it MUST match or the download is rejected. If no checksum
;; file exists at all (404), we proceed but warn.
fn download_repo(repo_file_path: string) -> bool is
    write("  Downloading repository list...")

    let ua: string = "isolator/" + constants::VERSION + " (+https://github.com/HackerOS-Linux-System/Isolator)"
    let __dstr90: (int, string) = util::http_get(constants::REPO_URL, ua)
    let status: int = __dstr90.0
    let body: string = __dstr90.1
    if status != 200 is
        if status < 0 is
            helpers::print_error("Failed to download repo list: transport error")
        else is
            helpers::print_error("Failed to download repo list: HTTP " + to_string(status))
        end
        return false
    end

    let validate: [PackageInfo] = parse_package_list(body)
    if array_len(validate) == 0 && string_trim(body) != "[]" is
        helpers::print_error("Downloaded file is invalid JSON")
        return false
    end
    let nv: int = array_len(validate)
    let mut i: int = 0
    while i < nv is
        let err: string = security::validate_package_name(validate[i].name)
        if err != "" is
            helpers::print_error("Downloaded repo contains an unsafe entry: " + err)
            return false
        end
        i += 1
    end

    let __dstr91: (int, string) = util::http_get(constants::REPO_URL + ".sha256", ua)
    let sum_status: int = __dstr91.0
    let sum_body: string = __dstr91.1
    if sum_status == 200 is
        if !security::verify_checksum(body, sum_body) is
            helpers::print_error("Checksum mismatch for repository list — refusing to install a possibly tampered file")
            return false
        end
    else is
        if config::load_config().require_checksum is
            helpers::print_error("No checksum published for the repository list, and require_checksum is enabled — refusing download")
            return false
        end
        helpers::print_warn("No checksum published for the repository list (repo.sha256 missing) — integrity not verified")
    end

    let tmp_path: string = repo_file_path + ".tmp"
    file_write(tmp_path, body)
    if !util::file_rename(tmp_path, repo_file_path) is
        if file_exists(tmp_path) is file_delete(tmp_path) end
        helpers::print_error("Failed to save repo file")
        return false
    end
    helpers::print_success("Repository list updated (" + to_string(nv) + " packages)")
    return true
end

pub fn read_repo_packages() -> [PackageInfo] is
    let path: string = helpers::get_repo_file_path()
    if !file_exists(path) is
        let __empty1: [PackageInfo] = []
        return __empty1
    end
    return parse_package_list(file_read(path))
end
