[package]
-> name        => isolator-store
-> version     => 0.7
-> description => GTK4 storefront for Isolator — search, install and remove packages via the isolator CLI (H# port)
-> author      => HackerOS Team <hackeros068@gmail.com>
-> license     => Apache-2.0

[build]
-> lang   => h#
-> entry  => src/main.h#
-> output => build/isolator-store

[deps]
-> gtk  => newest
-> libc => dynamic
