pub fn string_is_numeric(s: string) -> bool is
    if s == "" is return false end
    let n: int = string_len(s)
    let mut i: int = 0
    while i < n is
        let c: string = string_at(s, i)
        if c < "0" || c > "9" is return false end
        i += 1
    end
    return true
end

;; Accepts an optional leading '-' and at most one '.', matching what
;; strconv.ParseFloat would accept for the plain decimal forms .hk files use.
pub fn string_is_numeric_float(raw: string) -> bool is
    let s: string = string_trim(raw)
    if s == "" is return false end
    let n: int = string_len(s)
    let mut i: int = 0
    if string_at(s, 0) == "-" || string_at(s, 0) == "+" is i = 1 end
    if i >= n is return false end
    let mut seen_digit: bool = false
    let mut seen_dot:   bool = false
    while i < n is
        let c: string = string_at(s, i)
        if c >= "0" && c <= "9" is
            seen_digit = true
        else if c == "." && !seen_dot is
            seen_dot = true
        else is
            return false
        end
        i += 1
    end
    return seen_digit
end

pub fn string_to_int(s: string) -> int is
    ;; Manual digit-by-digit parse (avoids the free-function parse_int's
    ;; `int?` Optional return, which the H# type checker does not narrow
    ;; to plain `int` after a `== nil` guard — returning `r` directly after
    ;; the guard is a return-type mismatch at compile time). Accepts an
    ;; optional leading '-'/'+' and ignores surrounding whitespace (already
    ;; trimmed by callers); non-digit characters after the sign simply stop
    ;; the scan, matching strconv.Atoi-ish "parse as much as is valid"
    ;; behavior closely enough for this codebase's uses (trimmed shell
    ;; command output, .hk numeric literals).
    let t: string = string_trim(s)
    let n: int = string_len(t)
    let mut i: int = 0
    let mut neg: bool = false
    if n > 0 && (string_at(t, 0) == "-" || string_at(t, 0) == "+") is
        neg = string_at(t, 0) == "-"
        i = 1
    end
    let mut result: int = 0
    while i < n is
        let c: string = string_at(t, i)
        if c < "0" || c > "9" is
            i = n
        else is
            result = result * 10 + digit_val(c)
            i += 1
        end
    end
    return if neg then 0 - result else result 
end

pub fn string_to_float(s: string) -> f64 is
    ;; No free-function float parser is guaranteed; build it from digits.
    let t: string = string_trim(s)
    let n: int = string_len(t)
    let mut i: int = 0
    let mut neg: bool = false
    if n > 0 && (string_at(t, 0) == "-" || string_at(t, 0) == "+") is
        neg = string_at(t, 0) == "-"
        i = 1
    end
    let mut int_part: f64 = 0.0
    while i < n && string_at(t, i) != "." is
        let d: int = digit_val(string_at(t, i))
        int_part = int_part * 10.0 + int_to_float(d)
        i += 1
    end
    let mut frac: f64 = 0.0
    let mut scale: f64 = 0.1
    if i < n && string_at(t, i) == "." is
        i += 1
        while i < n is
            let d: int = digit_val(string_at(t, i))
            frac = frac + int_to_float(d) * scale
            scale = scale / 10.0
            i += 1
        end
    end
    let result: f64 = int_part + frac
    return if neg then 0.0 - result else result 
end

fn digit_val(c: string) -> int is
    if c == "0" is return 0 end
    if c == "1" is return 1 end
    if c == "2" is return 2 end
    if c == "3" is return 3 end
    if c == "4" is return 4 end
    if c == "5" is return 5 end
    if c == "6" is return 6 end
    if c == "7" is return 7 end
    if c == "8" is return 8 end
    if c == "9" is return 9 end
    return 0
end

pub fn int_to_float(n: int) -> f64 is
    return n as f64
end

pub fn float_to_int(f: f64) -> int is
    return f as int
end

;; ── Process execution (argv-safe) ───────────────────────────────────────────

pub fn shell_quote(s: string) -> string is
    ;; POSIX single-quote: end quote, escaped literal quote, reopen quote.
    let escaped: string = string_replace_all(s, "'", "'\\''")
    return "'" + escaped + "'"
end

pub fn quote_argv(args: [string]) -> string is
    let mut parts: [string] = []
    let n: int = array_len(args)
    let mut i: int = 0
    while i < n is
        parts = array_push(parts, shell_quote(args[i]))
        i += 1
    end
    return string_join(parts, " ")
end

;; run_argv executes `bin arg0 arg1 ...` (each arg shell-quoted) and returns
;; (exit_code, combined_stdout+stderr) — the H# analogue of Go's
;; exec.Command(bin, args...).CombinedOutput().
pub fn run_argv(bin: string, args: [string]) -> (int, string) is
    let cmd: string = shell_quote(bin) + " " + quote_argv(args)
    return run_capture(cmd)
end

;; run_capture executes a raw shell command string and returns
;; (exit_code, combined_output), using a temp file the same way bytes'
;; build.h# does (system() only gives an exit code, not captured output).
pub fn run_capture(cmd: string) -> (int, string) is
    let tmp: string = "/tmp/isolator_" + to_string(proc_id()) + "_" + to_string(time_ms()) + ".out"
    let rc: int = system(cmd + " >" + tmp + " 2>&1")
    let out: string = if file_exists(tmp) then file_read(tmp) else "" 
    if file_exists(tmp) is file_delete(tmp) end
    return (rc, out)
end

;; run_status executes argv and returns only the exit code (like
;; ExecCommand's bool return — ok := status == 0).
pub fn run_argv_status(bin: string, args: [string]) -> int is
    let cmd: string = shell_quote(bin) + " " + quote_argv(args)
    return system(cmd)
end

;; run_argv_status_visible runs argv WITHOUT redirecting stdout/stderr, so
;; the child's own output (progress bars, prompts, etc.) reaches the
;; terminal directly — used where the Go original relied on
;; cmd.Stdout/Stderr = os.Stdout for a passthrough (e.g. `isolator exec`).
pub fn run_argv_status_visible(bin: string, args: [string]) -> int is
    let cmd: string = shell_quote(bin) + " " + quote_argv(args)
    return system(cmd)
end

;; system_visible runs a raw shell command string with stdout/stderr
;; passed straight through to the terminal (unlike run_capture, which
;; redirects to a temp file). Used for chroot/mount-style commands piped
;; together with shell operators (&&, |, redirections) that can't be
;; expressed as a plain argv list.
pub fn system_visible(cmd: string) -> int is
    return system(cmd)
end

