;; format_rfc3339 converts a Unix epoch-seconds timestamp to a UTC
;; "YYYY-MM-DDTHH:MM:SSZ" string (civil_from_days algorithm — no timezone
;; database needed since this is always UTC, matching time.Now().UTC()
;; formatting semantics closely enough for a snapshot timestamp label).
pub fn format_rfc3339(epoch_secs: int) -> string is
    let days: int      = epoch_secs / 86400
    let secs_of_day: int = epoch_secs - (days * 86400)
    let hour: int = secs_of_day / 3600
    let minute: int = (secs_of_day - hour * 3600) / 60
    let second: int = secs_of_day - hour * 3600 - minute * 60

    ;; civil_from_days (Howard Hinnant), days since 1970-01-01
    let z: int = days + 719468
    let era: int = (if z >= 0 then z else z - 146096) / 146097
    let doe: int = z - era * 146097
    let yoe: int = (doe - doe/1460 + doe/36524 - doe/146096) / 365
    let y: int = yoe + era * 400
    let doy: int = doe - (365*yoe + yoe/4 - yoe/100)
    let mp: int = (5*doy + 2) / 153
    let d: int = doy - (153*mp + 2)/5 + 1
    let m: int = if mp < 10 then mp + 3 else mp - 9 
    let year: int = if m <= 2 then y + 1 else y 

    return to_string(year) + "-" + pad2(m) + "-" + pad2(d) + "T" + pad2(hour) + ":" + pad2(minute) + ":" + pad2(second) + "Z"
end

fn pad2(n: int) -> string is
    if n < 10 is return "0" + to_string(n) end
    return to_string(n)
end

