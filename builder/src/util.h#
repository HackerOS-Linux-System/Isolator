pub fn string_trim_start(s: string) -> string is
    let n: int = string_len(s)
    let mut i: int = 0
    while i < n is
        let c: string = string_at(s, i)
        if c != " " && c != "\t" && c != "\n" && c != "\r" is break end
        i += 1
    end
    return string_slice(s, i, n)
end

pub fn string_trim_end(s: string) -> string is
    return string_trim_right(s)
end

pub fn string_join(parts: [string], sep: string) -> string is
    let mut out: string = ""
    let n: int = array_len(parts)
    let mut i: int = 0
    while i < n is
        if i > 0 is out = out + sep end
        out = out + parts[i]
        i += 1
    end
    return out
end

