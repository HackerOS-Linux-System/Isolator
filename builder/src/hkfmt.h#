    if val.kind == "string" is return resolve_string(doc, val.str_val, visiting2) end
    if val.kind == "number" is return ("", format_hk_number(val.num_val)) end
    if val.kind == "bool"   is return ("", if val.bool_val then "true" else "false" ) end
    return ("InvalidReference(" + ref_ + "): cannot interpolate a map or array", "")
end

fn array_contains_str(a: [string], s: string) -> bool is
    let n: int = array_len(a)
    let mut i: int = 0
    while i < n is
        if a[i] == s is return true end
        i += 1
    end
    return false
end

