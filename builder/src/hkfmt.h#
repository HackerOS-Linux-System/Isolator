        let has_idx: bool = __dstr31.2
        if cur.kind != "map" is
            return ("InvalidReference(" + path + "): '" + key + "' is not a map", empty_value())
        end
        if !hkmap_has(cur.map_val, key) is
            return ("InvalidReference(" + path + "): key '" + key + "' not found", empty_value())
        end
        let mut next: HkValue = hkmap_get(cur.map_val, key)
        if has_idx is
            if next.kind != "array" || idx < 0 || idx >= array_len(next.arr_val) is
                return ("InvalidReference(" + path + "): index [" + to_string(idx) + "] out of range", empty_value())
            end
            next = next.arr_val[idx]
        end
        cur = next
        i += 1
    end
    return ("", cur)
end

fn split_index(seg: string) -> (string, int, bool) is
    if string_ends_with(seg, "]") is
        let open: int = string_rfind(seg, "[")
        if open > 0 is
            let idx_str: string = string_slice(seg, open + 1, string_len(seg) - 1)
            if util::string_is_numeric(idx_str) is
                return (string_slice(seg, 0, open), util::string_to_int(idx_str), true)
            end
        end
    end
    return (seg, 0, false)
end

;; ── Serialization ────────────────────────────────────────────────────────────

pub fn serialize_hk(doc: HkDocument) -> string is
    let mut b: string = ""
    let sections: [string] = hkmap_keys(doc.sections)
    let n: int = array_len(sections)
    let mut i: int = 0
    while i < n is
        if i > 0 is b = b + "\n" end
        let sec_name: string = sections[i]
        b = b + "[" + sec_name + "]\n"
        let sv: HkValue = hkmap_get(doc.sections, sec_name)
        b = b + write_map_body(sv.map_val, 1)
        i += 1
    end
    return b
end

fn write_map_body(m: HkMap, depth: int) -> string is
    let prefix: string = string_repeat("-", depth) + ">"
    let mut b: string = ""
    let ks: [string] = hkmap_keys(m)
    let n: int = array_len(ks)
    let mut i: int = 0
    while i < n is
        let k: string = ks[i]
        let v: HkValue = hkmap_get(m, k)
        let key: string = serialize_key(k)
        if v.kind == "map" is
            b = b + prefix + " " + key + "\n"
            b = b + write_map_body(v.map_val, depth + 1)
        else is
            b = b + prefix + " " + key + " => " + serialize_value(v) + "\n"
        end
        i += 1
    end
    return b
end

fn serialize_key(k: string) -> string is
    if string_contains(k, ".") is return "\"" + k + "\"" end
    return k
end

fn serialize_value(v: HkValue) -> string is
    if v.kind == "string" is
        if needs_quoting(v.str_val) is return "\"" + escape_hk_string(v.str_val) + "\"" end
        return v.str_val
    end
    if v.kind == "number" is return format_hk_number(v.num_val) end
    if v.kind == "bool"   is return (if v.bool_val then "true" else "false") end
    if v.kind == "array" is
        let mut parts: [string] = []
        let n: int = array_len(v.arr_val)
        let mut i: int = 0
        while i < n is
            parts = array_push(parts, serialize_value(v.arr_val[i]))
            i += 1
        end
        return "[" + util::string_join(parts, ", ") + "]"
    end
    return ""
end

fn needs_quoting(s: string) -> bool is
    if s == "" is return true end
    if string_contains(s, "\n") || string_contains(s, "\t") || string_contains(s, "\"") || string_contains(s, "\\") is
        return true
    end
    let lower: string = string_to_lower(string_trim(s))
    if lower == "true" || lower == "false" is return true end
    if util::string_is_numeric_float(string_trim(s)) is return true end
    return false
end

fn escape_hk_string(s: string) -> string is
    let s1: string = string_replace_all(s, "\\", "\\\\")
    let s2: string = string_replace_all(s1, "\"", "\\\"")
    let s3: string = string_replace_all(s2, "\n", "\\n")
    let s4: string = string_replace_all(s3, "\t", "\\t")
    let s5: string = string_replace_all(s4, "\r", "\\r")
    return s5
end

fn format_hk_number(n: f64) -> string is
    let as_int: int = util::float_to_int(n)
    if n == util::int_to_float(as_int) is return to_string(as_int) end
    return to_string(n)
end

;; WriteHKFile serializes doc and atomically writes it to path (best-effort
;; atomic: write to .tmp then rename).
pub fn write_hk_file(path: string, doc: HkDocument) -> string is
    let data: string = serialize_hk(doc)
    let tmp: string = path + ".tmp"
    file_write(tmp, data)
    util::file_rename(tmp, path)
    return ""
end
