;; Finds all ${...} occurrences in s and replaces them; returns
;; (had_any_markers, result). Bubbling up an error uses a sentinel prefix.
fn expand_one_pass(doc: HkDocument, s: string, visiting: [string]) -> (bool, string) is
    let n: int = string_len(s)
    let mut out: string = ""
    let mut i: int = 0
    let mut any_found: bool = false
    while i < n is
        if string_at(s, i) == "$" && i + 1 < n && string_at(s, i + 1) == "{" is
            let close: int = string_find(string_slice(s, i, n), "}")
