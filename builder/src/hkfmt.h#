fn resolve_ref(doc: HkDocument, ref_: string, visiting: [string]) -> (string, string) is
    if string_starts_with(ref_, "env:") is
        return ("", env_get(string_slice(ref_, 4, string_len(ref_))))
    end

    if array_contains_str(visiting, ref_) is
        return ("CyclicReference(" + ref_ + ")", "")
    end
    let visiting2: [string] = array_push(visiting, ref_)

    let __dstr30: (string, HkValue) = lookup_path(doc, ref_)
