;; copy_tree recursively copies src into dst, preserving structure and
;; symlinks, via `cp -a` (binary-safe, permission-preserving — matches the
;; Go original's filepath.Walk-based copy closely enough for this tool's
;; purposes). Returns "" on success, or an error message.
fn copy_tree(src: string, dst: string) -> string is
    if !util::dir_create_all(dst) is return "failed to create " + dst end
    let __dstr37: (int, string) = util::run_capture("cp -a " + util::shell_quote(src) + "/. " + util::shell_quote(dst) + "/")
    let rc: int = __dstr37.0
    let out: string = __dstr37.1
    if rc != 0 is return "cp -a failed: " + out end
    return ""
end

fn bool_label(b: bool, if_true: string, if_false: string) -> string is
    return if b then if_true else if_false 
end
