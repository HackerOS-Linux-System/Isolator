[package]
-> name        => isolator-daemon
-> version     => 0.1.0
-> description => Unattended scheduling daemon for Isolator maintenance commands
-> authors     => ["HackerOS-Linux-System"]
-> license     => Apache-2.0
-> lang        => h#

[edition]
-> edition   => 2026
-> toolchain => 0.9

[layout]
-> src   => src
-> entry => src/main.h#

[build]
-> link => static

[default-build]
-> profile => release
