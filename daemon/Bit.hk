[package]
-> name        => isolator-daemon
-> version     => 0.1
-> description => Unattended scheduling daemon for Isolator maintenance commands (H# port)
-> author      => HackerOS-Linux-System
-> license     => Apache-2.0

[build]
-> lang   => h#
-> entry  => src/main.h#
-> output => build/isolator-daemon

[deps]
-> libc => dynamic
